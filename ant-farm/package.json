{
  "name": "ant-farm",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "description": "Token Games: an ant farm that digs itself while your AI agent works. It lives in an orb in a corner of the screen and pops out into a window.",
  "main": "dist/main.js",
  "scripts": {
    "build": "node ../shell/scripts/build-game.mjs --extra scripts/bench.ts:bench.js",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/test/",
    "test:smoke": "npm run build && node ../shell/scripts/smoke.mjs",
    "shots": "npm run build && node ../shell/scripts/smoke.mjs --shots shots",
    "bench": "npm run build && node --expose-gc dist/bench.js",
    "perf": "npm run build && node ../shell/scripts/smoke.mjs --perf",
    "build:catalog": "node ../shell/scripts/build-web.mjs",
    "check:catalog": "node ../shell/scripts/build-web.mjs --check"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "electron": "38.2.2",
    "esbuild": "0.24.0",
    "typescript": "5.6.3"
  }
}
